{
  "name": "lunara",
  "private": true,
  "version": "0.1.0",
  "description": "Lunara — Laundry Management Platform",
  "packageManager": "npm@11.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@lunara/api",
    "build:customer-web": "turbo run build --filter=@lunara/customer-web",
    "build:admin-web": "turbo run build --filter=@lunara/admin-web",
    "build:partner-web": "turbo run build --filter=@lunara/partner-web",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.10"
  }
}
