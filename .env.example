# API
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
MONGODB_URI=mongodb://localhost:27017/lunara

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Local file uploads — avatars, documents, photos, and all other user uploads, plus generated
# catalog-addon placeholder icons. Defaults to <repo>/apps/api/uploads if unset.
UPLOAD_ROOT=

# Payments (PayMongo — GCash, Maya, card checkout + webhooks)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# Public key used client-side (partner-web) to tokenize a card directly against PayMongo for
# partner subscription auto-charge — never send the secret key to the browser.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

# Maps
GOOGLE_MAPS_API_KEY=
# Required for address autosuggest and map picker in admin-web (partners/new, branches)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase (push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMS / Email (Twilio Verify — all three required for real OTP SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Twilio phone number used to send general/automated SMS (e.g. weekly admin stats) — separate from Verify
TWILIO_SMS_FROM_NUMBER=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@lunara.app

# AI Agents — powers the Lunara AI Team chat app (apps/ai-agents)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# reCAPTCHA v3 — guards register/otp-request against automated signup abuse. Leave blank to
# disable (dev default). Get keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# CORS — comma-separated list of allowed web origins (required in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Web apps (public)
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3002
PARTNER_WEB_URL=http://localhost:3003
# PayMongo return origin from customer-mobile (should match CUSTOMER_WEB_URL in dev)
EXPO_PUBLIC_WEBSITE_URL=http://localhost:3000
# API base (with or without /api/v1 — hooks normalize automatically)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Physical devices cannot use localhost — the rider app rewrites to your PC's LAN IP in dev.
EXPO_PUBLIC_API_URL=http://localhost:3001
# ai-agents app only — optional, enables Google Analytics 4 (page views/visits/location). Leave blank to skip.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# customer-web SEO canonical/OG URL base — falls back to a hardcoded default if unset
NEXT_PUBLIC_SITE_URL=http://localhost:3000
