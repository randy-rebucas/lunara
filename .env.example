# API
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
MONGODB_URI=mongodb://localhost:27017/lunara

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
STRIPE_SECRET_KEY=
GCASH_MERCHANT_ID=
MAYA_PUBLIC_KEY=

# Maps
GOOGLE_MAPS_API_KEY=

# Firebase (push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMS / Email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# Web apps (public)
CUSTOMER_WEB_URL=http://localhost:3000
# API base (with or without /api/v1 — hooks normalize automatically)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Physical devices cannot use localhost — the rider app rewrites to your PC's LAN IP in dev.
EXPO_PUBLIC_API_URL=http://localhost:3001
