{
  "name": "@lunara/customer-mobile",
  "version": "1.2.7",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:build": "eas build --platform all --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit": "eas submit --platform all --profile production --latest",
    "eas-build-post-install": "cd ../.. && npm run build --workspace=@lunara/types && npm run build --workspace=@lunara/utils && npm run build --workspace=@lunara/config",
    "store-assets": "node scripts/generate-store-assets.mjs",
    "store-assets:captures": "node scripts/generate-store-assets.mjs --captures ./captures",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/**/*.test.ts"
  },
  "dependencies": {
    "@lunara/brand": "*",
    "@lunara/config": "*",
    "@lunara/types": "*",
    "@lunara/utils": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "^57",
    "expo-application": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@types/node": "^22.15.30",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.34.5",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  }
}
