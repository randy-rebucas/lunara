{
  "name": "@lunara/customer-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "eas:build": "eas build --platform all --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit": "eas submit --platform all --profile production --latest",
    "eas-build-post-install": "cd ../.. && npm run build --workspace=@lunara/types && npm run build --workspace=@lunara/utils && npm run build --workspace=@lunara/config",
    "store-assets": "node scripts/generate-store-assets.mjs",
    "store-assets:captures": "node scripts/generate-store-assets.mjs --captures ./captures",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/**/*.test.ts"
  },
  "dependencies": {
    "@lunara/brand": "*",
    "@lunara/config": "*",
    "@lunara/types": "*",
    "@lunara/utils": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.0",
    "expo-camera": "~17.0.10",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^10.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
