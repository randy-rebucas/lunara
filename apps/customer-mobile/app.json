{
  "expo": {
    "name": "Lunara",
    "slug": "lunara-customer",
    "version": "1.0.4",
    "scheme": "lunara",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.lunara.customer",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lunara.customer",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "../../packages/brand/assets/icon.png",
          "color": "#6366f1",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lunara uses your location to pin pickup and delivery addresses accurately."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lunara uses your photo library so you can set a profile picture."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
