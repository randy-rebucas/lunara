{
  "expo": {
    "name": "Lunara",
    "slug": "lunara-customer",
    "version": "1.2.4",
    "scheme": "lunara",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/logo.png",
    "ios": {
      "bundleIdentifier": "com.lunara.customer",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lunara.customer",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "../../packages/brand/assets/icon.png",
          "color": "#6366f1",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lunara uses your location to pin pickup and delivery addresses accurately."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lunara uses your photo library so you can set a profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lunara uses your camera to scan your laundry tag's QR code."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "randyreb",
    "extra": {
      "eas": {
        "projectId": "08355e56-d5dc-4fe0-b11c-8b6a27691dc5"
      }
    }
  }
}