{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "node": "20.0.0",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-jelave": {
      "extends": "preview",
      "env": {
        "LUNARA_PARTNER_SLUG": "jelave"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.0.0",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-jelave": {
      "extends": "production",
      "env": {
        "LUNARA_PARTNER_SLUG": "jelave"
      }
    }
  },
  "submit": {
    "production": {}
  }
}