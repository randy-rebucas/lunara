{
  "name": "@lunara/partner-mobile",
  "version": "1.1.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8083",
    "dev:clear": "expo start --clear --port 8083",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "eas:build": "eas build --platform all --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas-build-post-install": "cd ../.. && npm run build --workspace=@lunara/types && npm run build --workspace=@lunara/utils && npm run build --workspace=@lunara/config",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lunara/brand": "*",
    "@lunara/config": "*",
    "@lunara/types": "*",
    "@lunara/utils": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
