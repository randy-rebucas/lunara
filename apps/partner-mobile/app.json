{
  "expo": {
    "name": "Lunara Partner",
    "slug": "lunara-partner",
    "version": "0.1.0",
    "scheme": "lunara-partner",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.lunara.partner",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lunara.partner"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Lunara Partner uses your camera to scan order and laundry-tag QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lunara Partner uses your camera to take a profile photo.",
          "photosPermission": "Lunara Partner can access photos when you choose a profile picture."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
