{
  "expo": {
    "name": "Lunara Staff",
    "slug": "lunara-staff",
    "version": "1.1.2",
    "scheme": "lunara-staff",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.lunara.staff",
      "supportsTablet": false
    },
    "android": {
      "package": "com.lunara.staff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "../../packages/brand/assets/icon.png",
          "color": "#6366f1",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lunara Staff uses your camera to scan order and laundry-tag QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lunara Staff uses your camera to take a profile photo.",
          "photosPermission": "Lunara Staff can access photos when you choose a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lunara Staff records your location when you clock in or out."
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
